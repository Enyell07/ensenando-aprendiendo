---
// Recibe un episodio ya normalizado (ver src/lib/youtube.js)
const { slug, title, thumbnail, publishedAt, description = '' } = Astro.props;
const fecha = new Date(publishedAt).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
---
<a class="ep-card" href={`/podcast/${slug}`}>
  <div class="ep-thumb">
    <img src={thumbnail} alt={`Miniatura del episodio: ${title}`} loading="lazy" />
    <span class="ep-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 3l14 9-14 9V3z"/></svg></span>
  </div>
  <div class="ep-body">
    <p class="ep-date">{fecha}</p>
    <h3>{title}</h3>
    <p class="ep-desc">{description.slice(0, 110)}{description.length > 110 ? '…' : ''}</p>
  </div>
</a>
