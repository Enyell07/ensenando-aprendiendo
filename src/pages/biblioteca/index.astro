---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recursos = await getCollection('biblioteca');
---
<BaseLayout title="Biblioteca — Enseñando aprendiendo" description="Recursos educativos para estudiantes y docentes.">
  <div class="page-head">
    <p class="kicker">Biblioteca</p>
    <h1>Recursos educativos</h1>
    <p>Guías, lecturas, enlaces y actividades relacionadas con los episodios.</p>
  </div>
  <div class="page-body">
    <div class="list">
      {recursos.map((r) => (
        <div class="item">
          <span class="demo-tag" style="margin:0;">{r.data.tipo} · {r.data.publico}</span>
          <h3>{r.data.titulo}</h3>
          <p>{r.data.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
