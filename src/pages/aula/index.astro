---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articulos = (await getCollection('aula')).sort((a, b) => b.data.fecha - a.data.fecha);
---
<BaseLayout title="Aula — Enseñando aprendiendo" description="Reflexiones y experiencias educativas de la comunidad.">
  <div class="page-head">
    <p class="kicker">Aula</p>
    <h1>Reflexiones y experiencias</h1>
    <p>Artículos sobre educación, enseñanza, aprendizaje e innovación.</p>
  </div>
  <div class="page-body">
    <div class="list">
      {articulos.map((a) => (
        <div class="item">
          <p class="ep-date">{a.data.categoria} · {a.data.autor}</p>
          <h3>{a.data.titulo}</h3>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
