---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articulos = (await getCollection('aula')).sort((a, b) => b.data.fecha - a.data.fecha);
---
<BaseLayout title="Aula — Enseñando aprendiendo">
  <section class="wrap" style="padding:48px 24px;">
    <h1 style="font-family:'Fraunces',serif; font-size:30px; margin-bottom:28px;">Aula</h1>
    <div style="display:grid; gap:20px;">
      {articulos.map((a) => (
        <div style="border-bottom:1px solid var(--border); padding-bottom:20px;">
          <p style="font-size:12.5px; color:var(--text-muted); margin-bottom:6px;">{a.data.categoria} · {a.data.autor}</p>
          <h3 style="font-family:'Fraunces',serif; font-size:19px;">{a.data.titulo}</h3>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
