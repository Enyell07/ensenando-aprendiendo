---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { getEpisodes } from '../../lib/youtube.js';

const episodios = await getEpisodes();
---
<BaseLayout title="Podcast — Enseñando aprendiendo" description="Todos los episodios del podcast Enseñando aprendiendo, con el profe Angel.">
  <div class="page-head">
    <p class="kicker">Sala de podcast</p>
    <h1>Todos los episodios</h1>
    <p>Mira o escucha cada episodio del podcast.</p>
  </div>
  <div class="page-body">
    <div class="ep-grid" style="max-width:none;">
      {episodios.map((ep) => <EpisodeCard {...ep} />)}
    </div>
  </div>
</BaseLayout>
