---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEpisodes } from '../../lib/youtube.js';
import { getCollection } from 'astro:content';

// getStaticPaths le dice a Astro qué páginas de episodio generar: una por cada video de la playlist.
export async function getStaticPaths() {
  const episodios = await getEpisodes();
  return episodios.map((ep) => ({ params: { slug: ep.slug }, props: { episodio: ep } }));
}

const { episodio } = Astro.props;
const fecha = new Date(episodio.publishedAt).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(Astro.url.pathname, Astro.site).href;
const textoCompartir = encodeURIComponent(`${episodio.title} — Enseñando aprendiendo ${url}`);

// Información extra cargada desde /admin (transcripción y recursos)
const extra = (await getCollection('episodios_extra')).find((e) => e.data.slug_episodio === episodio.slug);
const recursos = extra?.data.recursos ?? [];
const transcripcion = extra?.data.transcripcion ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: episodio.title,
  description: episodio.description,
  datePublished: episodio.publishedAt,
  image: episodio.thumbnail,
  partOfSeries: { '@type': 'PodcastSeries', name: 'Enseñando aprendiendo' }
};
---
<BaseLayout title={`${episodio.title} — Enseñando aprendiendo`} description={episodio.description.slice(0, 160)} jsonLd={jsonLd}>
  <article class="ep-article">
    <p class="crumb"><a href="/">Inicio</a> / <a href="/podcast">Podcast</a> / Episodio</p>
    <h1>{episodio.title}</h1>
    <p class="meta">{fecha}</p>

    <div class="player">
      {episodio.videoId ? (
        <iframe src={`https://www.youtube.com/embed/${episodio.videoId}`} title={episodio.title} allowfullscreen loading="lazy"></iframe>
      ) : (
        <p>Video de ejemplo (demo). Cuando conectes YouTube, aquí aparece el reproductor real.</p>
      )}
    </div>

    <div class="share">
      <a class="chip" href={`https://wa.me/?text=${textoCompartir}`} target="_blank" rel="noopener">Compartir en WhatsApp</a>
      <a class="chip" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Compartir en Facebook</a>
      <button class="chip" type="button" id="copiar" data-url={url}>Copiar enlace</button>
      {episodio.videoId && <a class="chip" href={`https://www.youtube.com/watch?v=${episodio.videoId}`} target="_blank" rel="noopener">Ver en YouTube</a>}
    </div>

    <p class="desc">{episodio.description}</p>

    {recursos.length > 0 && (
      <section class="extra">
        <h2>Recursos del episodio</h2>
        <ul>
          {recursos.map((r) => <li><a href={r.enlace} target="_blank" rel="noopener">{r.titulo}</a></li>)}
        </ul>
      </section>
    )}

    {transcripcion && (
      <details class="extra">
        <summary>Ver transcripción</summary>
        <p class="desc">{transcripcion}</p>
      </details>
    )}
  </article>
  <script is:inline>
    (function () {
      var b = document.getElementById('copiar');
      if (!b) return;
      b.addEventListener('click', function () {
        var u = b.getAttribute('data-url');
        if (navigator.clipboard) { navigator.clipboard.writeText(u).then(function () { b.textContent = '¡Enlace copiado!'; }); }
        else { window.prompt('Copia este enlace:', u); }
      });
    })();
  </script>
</BaseLayout>
